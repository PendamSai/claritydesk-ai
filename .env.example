CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# Hosting configuration (leave endpoint empty for local Ollama)
PUBLIC_DEPLOYMENT=false
OLLAMA_BASE_URL=

# Free cloud alternative: set AI_PROVIDER=gemini and supply a free-tier key.
AI_PROVIDER=ollama
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_DAILY_REQUEST_LIMIT=100
