# Copy these entries into Streamlit Community Cloud > App settings > Secrets.
# Do not commit a real key or paste it in chat.
AI_PROVIDER = "gemini"
PUBLIC_DEPLOYMENT = "true"
GEMINI_MODEL = "gemini-2.5-flash-lite"
GEMINI_API_KEY = "replace-with-your-free-tier-key"
GEMINI_DAILY_REQUEST_LIMIT = "100"
